# ============================================
# Twelve-Factor App: Configurações de Ambiente
# ============================================
# Copie este arquivo para .env e ajuste os valores
# NUNCA commite o arquivo .env no repositório!

# ----------------------
# Database Configuration
# ----------------------
POSTGRES_DB=quarkusdb
POSTGRES_USER=quarkus
POSTGRES_PASSWORD=change-me-in-production

# URL de conexão (para desenvolvimento local sem Docker)
DB_URL=jdbc:postgresql://localhost:5432/quarkusdb

# ----------------------
# Security Configuration
# ----------------------
# Gere uma chave segura com: openssl rand -base64 32
# OBRIGATÓRIO em produção!
SESSION_ENCRYPTION_KEY=

# ----------------------
# Flyway Migrations
# ----------------------
# Em produção, defina como 'false' e execute migrações via Job separado
FLYWAY_MIGRATE_AT_START=true

# ----------------------
# CORS Configuration (Fifteen-Factor XV)
# ----------------------
# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
